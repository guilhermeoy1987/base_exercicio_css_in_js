# Indica que este é o arquivo de configuração raiz
root = true

# Configurações para todos os arquivos
[*]
indent_style = space          # Usa espaços em vez de tabs
indent_size = 2               # Define o tamanho da indentação como 2 espaços
end_of_line = lf              # Padroniza quebra de linha (padrão Linux/Git)
charset = utf-8               # Codificação de caracteres universal
trim_trailing_whitespace = true # Remove espaços inúteis no fim das linhas
insert_final_newline = true    # Adiciona uma linha em branco ao final do arquivo